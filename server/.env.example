# 复制为 server/.env 后按需修改（.env 已被 .gitignore 忽略）

# 监听端口与地址
PORT=3000
HOST=0.0.0.0

# 生产环境接 MongoDB；留空则用 server/data 下的 JSON 文件（仅适合本地）
# MONGO_URL=mongodb://127.0.0.1:27017
MONGO_DB=onetwo

# 对外域名，用于拼接图片/文件的绝对地址（Nginx 反代后建议设置为你的 HTTPS 域名）
# PUBLIC_BASE=https://your-domain.com

# 微信小程序（不配 AppSecret 时登录走 openid_ 哈希降级，仅适合开发）
WX_APP_ID=
WX_APP_SECRET=
WX_TEMPLATE_ID=0IKc45bcYw7j_ASZPc8ajIZ7pJ05ruH0c3zbGFbqEzE

# 单个上传文件大小上限（MB）
MAX_UPLOAD_MB=20

# 设为 0 关闭逐条请求日志
LOG_REQUESTS=1
