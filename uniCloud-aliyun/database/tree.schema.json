{
  "bsonType": "object",
  "required": ["content", "creatorOpenid"],
  "permission": {
    "read": true,
    "create": true,
    "update": true,
    "delete": true
  },
  "properties": {
    "_id": {
      "description": "ID，系统自动生成"
    },
    "content": {
      "bsonType": "string",
      "description": "内容"
    },
    "tag": {
      "bsonType": "string",
      "description": "标签"
    },
    "tagColor": {
      "bsonType": "string",
      "description": "标签颜色"
    },
    "anonymous": {
      "bsonType": "bool",
      "description": "是否匿名"
    },
    "creatorOpenid": {
      "bsonType": "string",
      "description": "创建者openid"
    },
    "creatorName": {
      "bsonType": "string",
      "description": "创建者昵称"
    },
    "hugCount": {
      "bsonType": "int",
      "description": "抱抱数"
    },
    "replyCount": {
      "bsonType": "int",
      "description": "回复数"
    },
    "replies": {
      "bsonType": "array",
      "description": "回复列表"
    },
    "createTime": {
      "bsonType": "timestamp",
      "description": "创建时间"
    }
  }
}
