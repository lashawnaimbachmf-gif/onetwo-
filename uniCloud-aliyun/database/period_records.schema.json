{
  "bsonType": "object",
  "required": ["startDate", "creatorOpenid"],
  "permission": {
    "read": true,
    "create": true,
    "update": true,
    "delete": true
  },
  "properties": {
    "_id": {
      "description": "ID，系统自动生成"
    },
    "startDate": {
      "bsonType": "string",
      "description": "经期开始日期 YYYY-MM-DD"
    },
    "endDate": {
      "bsonType": "string",
      "description": "经期结束日期 YYYY-MM-DD"
    },
    "flow": {
      "bsonType": "string",
      "description": "经量：多/中/少",
      "enum": ["多", "中", "少"]
    },
    "symptoms": {
      "bsonType": "array",
      "arrayType": "string",
      "description": "症状标签"
    },
    "notes": {
      "bsonType": "string",
      "description": "备注"
    },
    "creatorOpenid": {
      "bsonType": "string",
      "description": "创建者openid"
    },
    "createTime": {
      "bsonType": "timestamp",
      "description": "创建时间"
    }
  }
}
