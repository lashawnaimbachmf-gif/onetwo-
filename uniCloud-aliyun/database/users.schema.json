{
  "bsonType": "object",
  "required": ["openid"],
  "permission": {
    "read": false,
    "create": false,
    "update": false,
    "delete": false
  },
  "properties": {
    "_id": {
      "description": "ID，系统自动生成"
    },
    "openid": {
      "bsonType": "string",
      "description": "微信用户唯一标识"
    },
    "nickName": {
      "bsonType": "string",
      "description": "用户昵称"
    },
    "avatarUrl": {
      "bsonType": "string",
      "description": "用户头像"
    },
    "createTime": {
      "bsonType": "timestamp",
      "description": "创建时间"
    },
    "lastLoginTime": {
      "bsonType": "timestamp",
      "description": "最后登录时间"
    },
    "partnerOpenid": {
      "bsonType": "string",
      "description": "伴侣的openid"
    },
    "partnerInfo": {
      "bsonType": "object",
      "description": "伴侣信息"
    },
    "isBind": {
      "bsonType": "bool",
      "description": "是否已绑定伴侣",
      "default": false
    },
    "bindTime": {
      "bsonType": "timestamp",
      "description": "绑定时间"
    }
  }
}
